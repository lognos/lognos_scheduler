{
  "inputs": [
    {
      "type": "promptString",
      "id": "supabase-access-token",
      "description": "Supabase personal access token",
      "password": true
    },
    {
      "type": "promptString",
      "id": "logfire-read-token",
      "description": "Logfire read token",
      "password": true
    }
  ],
  "servers": {
    "supabase": {
      "command": "npx",
      "args": [
        "-y",
        "@supabase/mcp-server-supabase@latest"
      ],
      "env": {
        "SUPABASE_ACCESS_TOKEN": "${input:supabase-access-token}"
      }
    },
    "logfire": {
      "type": "stdio",
      "command": "uvx",
      "args": [
        "logfire-mcp@latest"
      ],
      "env": {
        "LOGFIRE_READ_TOKEN": "${input:logfire-read-token}"
      }
    }
  }
}